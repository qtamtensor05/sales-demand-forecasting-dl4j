COMPOSE_PROJECT_NAME=sales-demand-forecasting

# Repository path policy. Relative values are resolved from the project root.
DATA_DIR=./data
OUTPUT_DIR=./output
ARTIFACTS_DIR=./artifacts
# Compatibility mount: keep the validated historical deployment until a promoted artifact passes parity checks.
MODEL_ARTIFACT_DIR=./output/runs/2026-10-13_025422_624_gpu/deployment

# Replace these development-only values in .env before using shared machines.
MINIO_ROOT_USER=salesadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=sales_forecast
POSTGRES_USER=sales_app
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_1_UI_PORT=8081
SPARK_WORKER_2_UI_PORT=8082
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=1g
SPARK_TIMEOUT_SECONDS=600

FORECAST_SERVICE_PORT=8083
BACKEND_API_PORT=8084
FRONTEND_PORT=3000

